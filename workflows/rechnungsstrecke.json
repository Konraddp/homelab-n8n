    {
      "parameters": {
        "jsCode": "// Ein Element pro PDF-Anhang, der nach Rechnung aussieht.\n// Regel: Stichwort im Dateinamen ODER im Betreff, und kein Ausschluss-Stichwort im Dateinamen.\nconst STICHWORTE = /(rechnung|receipt|invoice|quittung|beleg)/i;\nconst AUSSCHLUSS = /(agb|widerruf|terms|datenschutz|privacy|bedingungen)/i;\n\nconst out = [];\n\nfor (const item of $input.all()) {\n  const betreffTreffer = STICHWORTE.test(item.json.subject ?? '');\n\n  for (const bin of Object.values(item.binary ?? {})) {\n    const name = bin.fileName ?? '';\n    const isPdf = bin.mimeType === 'application/pdf' || name.toLowerCase().endsWith('.pdf');\n    if (!isPdf) continue;\n    if (AUSSCHLUSS.test(name)) continue;\n    if (!STICHWORTE.test(name) && !betreffTreffer) continue;\n\n    out.push({\n      json: {\n        messageId: item.json.messageId,\n        subject: item.json.subject,\n        from: item.json.from?.value?.[0]?.address ?? null,\n        receivedAt: item.json.date,\n        fileName: name,\n        mimeType: bin.mimeType,\n        grund: STICHWORTE.test(name) ? 'dateiname' : 'betreff',\n      },\n      binary: { data: bin },\n    });\n  }\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "a5c2f935-95ea-4b61-9cc8-c61765df3934",
      "name": "PDF-Anhänge extrahieren"
