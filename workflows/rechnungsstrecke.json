    {
      "parameters": {
        "jsCode": "// Ein Element pro PDF-Anhang, mit den Mail-Metadaten\nconst out = [];\n\nfor (const item of $input.all()) {\n  const binaries = item.binary ?? {};\n\n  for (const bin of Object.values(binaries)) {\n    const name = (bin.fileName ?? '').toLowerCase();\n    const isPdf = bin.mimeType === 'application/pdf' || name.endsWith('.pdf');\n    if (!isPdf) continue;\n\n    out.push({\n      json: {\n        messageId: item.json.messageId,\n        subject: item.json.subject,\n        from: item.json.from?.value?.[0]?.address ?? null,\n        receivedAt: item.json.date,\n        fileName: bin.fileName,\n        mimeType: bin.mimeType,\n      },\n      binary: { data: bin },\n    });\n  }\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
