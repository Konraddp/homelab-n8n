        "query": "INSERT INTO automation.processed_attachments (message_id, attachment_sha256, filename, status)\nVALUES ($1, $2, $3, 'pending')\nON CONFLICT (attachment_sha256) DO NOTHING\nRETURNING id, attachment_sha256;",
        "options": {
