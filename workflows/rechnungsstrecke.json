      "id": "e2e9299e-8452-40e0-bad6-a16660970f38",
      "name": "Upload Paperless",
      "credentials": {
        "httpHeaderAuth": {
          "id": "U6k83Liz7xQq6Ft6",
          "name": "Paperless API (User n8n)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// PDF aus \"PDF-Anhänge extrahieren\", Hash aus \"Crypto\" (gleiche Reihenfolge, 1:1).\n// Weitergegeben werden nur Anhänge, die der Duplikat-Check als neu eingetragen hat.\nconst pdfs   = $('PDF-Anhänge extrahieren').all();\nconst hashes = $('Crypto').all();\n\nconst neu = new Map(\n  $input.all()\n    .filter(i => i.json.attachment_sha256)\n    .map(i => [i.json.attachment_sha256.trim(), i.json.id])\n);\n\nconst out = [];\nhashes.forEach((h, idx) => {\n  const hash = h.json.sha256;\n  if (!neu.has(hash)) return;               // Duplikat → überspringen\n\n  const pdf = pdfs[idx];\n  if (!pdf?.binary?.data) {\n    throw new Error(`Kein PDF zum Hash ${hash} (Position ${idx})`);\n  }\n  out.push({\n    json: { ...h.json, dedupId: neu.get(hash) },\n    binary: { data: pdf.binary.data },\n  });\n});\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
